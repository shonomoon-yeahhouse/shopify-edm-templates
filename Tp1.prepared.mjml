<mjml>
  <mj-head>
    <mj-preview>{{preheader}}</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text color="#202124" line-height="1.55" />
      <mj-image alt="Women's fashion" />
    </mj-attributes>
    <mj-style inline="inline">a { text-decoration: none; } .hero img { object-fit: contain; }</mj-style>
  </mj-head>
  <mj-body background-color="#f3f4f6" width="640px">
    <mj-section background-color="#ffffff" padding="18px 24px 12px">
      <mj-column><mj-image src="{{brand_logo}}" href="{{logo_link}}" width="180px" padding="0" /></mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="0 24px 14px">
      <mj-column><mj-text align="center" font-size="13px" font-weight="600" padding="0">{{navigation_html}}</mj-text></mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="0 18px">
      <mj-column><mj-image css-class="hero" src="{{hero_image}}" href="{{hero_url}}" padding="0" fluid-on-mobile="true" /></mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="24px 34px 18px">
      <mj-column>
        <mj-text align="center" font-size="30px" font-weight="600" padding="0 0 12px">{{heading}}</mj-text>
        <mj-text align="center" font-size="16px" padding="0 0 12px">{{body}}</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="0 18px"><mj-group width="100%">
      <mj-column width="50%" padding="8px">
        <mj-image src="{{product_1_image}}" href="{{product_1_url}}" padding="0" fluid-on-mobile="true" />
        <mj-text align="center" font-size="15px" font-weight="600" padding="12px 4px 4px">{{product_1_title}}</mj-text>
        <mj-button href="{{product_1_url}}" background-color="#111827" color="#ffffff" border-radius="2px" height="44px" padding="8px 12px 18px">{{product_1_button}}</mj-button>
      </mj-column>
      <mj-column width="50%" padding="8px">
        <mj-image src="{{product_2_image}}" href="{{product_2_url}}" padding="0" fluid-on-mobile="true" />
        <mj-text align="center" font-size="15px" font-weight="600" padding="12px 4px 4px">{{product_2_title}}</mj-text>
        <mj-button href="{{product_2_url}}" background-color="#111827" color="#ffffff" border-radius="2px" height="44px" padding="8px 12px 18px">{{product_2_button}}</mj-button>
      </mj-column>
    </mj-group></mj-section><mj-section background-color="#ffffff" padding="0 18px"><mj-group width="100%">
      <mj-column width="50%" padding="8px">
        <mj-image src="{{product_3_image}}" href="{{product_3_url}}" padding="0" fluid-on-mobile="true" />
        <mj-text align="center" font-size="15px" font-weight="600" padding="12px 4px 4px">{{product_3_title}}</mj-text>
        <mj-button href="{{product_3_url}}" background-color="#111827" color="#ffffff" border-radius="2px" height="44px" padding="8px 12px 18px">{{product_3_button}}</mj-button>
      </mj-column>
      <mj-column width="50%" padding="8px">
        <mj-image src="{{product_4_image}}" href="{{product_4_url}}" padding="0" fluid-on-mobile="true" />
        <mj-text align="center" font-size="15px" font-weight="600" padding="12px 4px 4px">{{product_4_title}}</mj-text>
        <mj-button href="{{product_4_url}}" background-color="#111827" color="#ffffff" border-radius="2px" height="44px" padding="8px 12px 18px">{{product_4_button}}</mj-button>
      </mj-column>
    </mj-group></mj-section><mj-section background-color="#ffffff" padding="0 18px"><mj-group width="100%">
      <mj-column width="50%" padding="8px">
        <mj-image src="{{product_5_image}}" href="{{product_5_url}}" padding="0" fluid-on-mobile="true" />
        <mj-text align="center" font-size="15px" font-weight="600" padding="12px 4px 4px">{{product_5_title}}</mj-text>
        <mj-button href="{{product_5_url}}" background-color="#111827" color="#ffffff" border-radius="2px" height="44px" padding="8px 12px 18px">{{product_5_button}}</mj-button>
      </mj-column>
      <mj-column width="50%" padding="8px">
        <mj-image src="{{product_6_image}}" href="{{product_6_url}}" padding="0" fluid-on-mobile="true" />
        <mj-text align="center" font-size="15px" font-weight="600" padding="12px 4px 4px">{{product_6_title}}</mj-text>
        <mj-button href="{{product_6_url}}" background-color="#111827" color="#ffffff" border-radius="2px" height="44px" padding="8px 12px 18px">{{product_6_button}}</mj-button>
      </mj-column>
    </mj-group></mj-section>
    <mj-section background-color="#ffffff" padding="24px 30px 30px">
      <mj-column>
        <mj-divider border-color="#e5e7eb" border-width="1px" padding="0 0 18px" />
        <mj-text align="center" color="#6b7280" font-size="12px" padding="0 0 7px">{{footer_text}}</mj-text>
        <mj-text align="center" color="#6b7280" font-size="12px" padding="0 0 7px">Copyright © {{store_name}} · {{support_email}}</mj-text>
        <mj-text align="center" color="#6b7280" font-size="12px" padding="0"><a href="{{unsubscribe_url}}">Unsubscribe</a></mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

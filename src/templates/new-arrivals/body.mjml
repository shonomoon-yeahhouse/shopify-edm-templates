<mjml><mj-head><mj-attributes><mj-all font-family="Arial, Helvetica, sans-serif" /></mj-attributes></mj-head><mj-body background-color="#f3f4f6">
<mj-raw>{{brand_header_html}}{{sale_top_html}}</mj-raw><mj-section padding="0"><mj-column><mj-image padding="0" href="{{hero_url}}" src="{{hero_image}}" /></mj-column></mj-section>
<mj-section><mj-column><mj-text align="center" font-size="30px" font-weight="700">{{heading}}</mj-text><mj-text align="center" font-size="16px">{{body}}</mj-text><mj-button background-color="#111827" href="{{cta_url}}">{{cta_text}}</mj-button></mj-column></mj-section>
<mj-raw>{{sale_middle_html}}</mj-raw><mj-section><mj-column width="50%"><mj-image href="{{product_1_url}}" src="{{product_1_image}}" /><mj-text font-weight="600">{{product_1_title}}</mj-text><mj-button background-color="#111827" href="{{product_1_url}}">{{product_1_button}}</mj-button></mj-column><mj-column width="50%"><mj-image href="{{product_2_url}}" src="{{product_2_image}}" /><mj-text font-weight="600">{{product_2_title}}</mj-text><mj-button background-color="#111827" href="{{product_2_url}}">{{product_2_button}}</mj-button></mj-column><mj-column width="50%"><mj-image href="{{product_3_url}}" src="{{product_3_image}}" /><mj-text font-weight="600">{{product_3_title}}</mj-text><mj-button background-color="#111827" href="{{product_3_url}}">{{product_3_button}}</mj-button></mj-column><mj-column width="50%"><mj-image href="{{product_4_url}}" src="{{product_4_image}}" /><mj-text font-weight="600">{{product_4_title}}</mj-text><mj-button background-color="#111827" href="{{product_4_url}}">{{product_4_button}}</mj-button></mj-column></mj-section><mj-raw>{{sale_bottom_html}}{{brand_footer_html}}</mj-raw>
<mj-section><mj-column><mj-text align="center" font-size="12px"><a href="{{unsubscribe_url}}">{{unsubscribe_label}}</a></mj-text></mj-column></mj-section></mj-body></mjml>